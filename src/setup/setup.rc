#include <windows.h>
#include "setup.h"

#ifndef DS_3DLOOK
#define DS_3DLOOK 0x0004L
#endif

#ifndef NO_NT31
IDF_EXE31   NTRDPSFILE  "setup\\nt31\\ntrdps.exe"
IDF_HOOK31  NTRDPSFILE  "setup\\nt31\\ntrdpshk.dll"
IDF_LAYER31 NTRDPSFILE  "setup\\nt31\\ntrdpsly.dll"
#endif
IDF_EXE35   NTRDPSFILE  "setup\\nt35\\ntrdps.exe"
IDF_HOOK35  NTRDPSFILE  "setup\\nt35\\ntrdpshk.dll"
IDF_LAYER35 NTRDPSFILE  "setup\\nt35\\ntrdpsly.dll"
IDF_MRSYS   NTRDPSFILE  "setup\\nt40\\ntrdpsmr.sys"
IDF_MRDLL   NTRDPSFILE  "setup\\nt40\\ntrdpsmr.dll"
IDF_MRDLL0  NTRDPSFILE  "setup\\nt40\\ntrdpsm0.dll"

IDD_SETUP DIALOG 0, 0, 268, 258
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ntrdps Setup"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "ntrdps lets RDP clients (Remote Desktop) use the console of this computer.",
                    -1, 8, 6, 252, 10
#ifdef NTRDPS_LOGIN
    AUTOCHECKBOX    "&Ask for a user name and password   (recommended)",
                    IDC_CB_LOGIN, 8, 17, 252, 10, WS_TABSTOP
    LTEXT           "", IDC_LOGIN_TEXT, 20, 28, 240, 8
#else
    LTEXT           "No encryption and no login: anyone who can reach TCP port 3389 gets the console. Use it only on a network you trust.",
                    -1, 8, 18, 252, 18
#endif
    GROUPBOX        "How ntrdps watches the screen", -1, 4, 40, 260, 88
    AUTORADIOBUTTON "&Fast - display driver   (recommended)",
                    IDC_RB_DRIVER, 10, 51, 248, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "Good: about 9 of 10 fewer bytes on the network, less CPU, and the moving frame shows when you drag a window. Cost: one reboot. Rare risk: a display-driver fault could stop the desktop at boot (fix: boot Last Known Good).",
                    -1, 20, 62, 240, 32
    AUTORADIOBUTTON "&Safe - read the screen (no driver)",
                    IDC_RB_POLL, 10, 98, 248, 10
    LTEXT           "Good: no driver, no reboot, works on every machine. Cost: slower, more network and CPU, and no moving frame while you drag a window.",
                    -1, 20, 109, 240, 18
    GROUPBOX        "Install will", -1, 4, 132, 260, 64
    LTEXT           "", IDC_PLAN, 10, 143, 248, 50
    GROUPBOX        "Now", -1, 4, 200, 260, 32
    LTEXT           "", IDC_STATUS, 10, 210, 248, 18
    DEFPUSHBUTTON   "&Install", IDC_INSTALL, 51, 238, 50, 14
    PUSHBUTTON      "&Remove", IDC_REMOVE, 109, 238, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 167, 238, 50, 14
END

#ifdef NTRDPS_LOGIN
IDD_ACCOUNT DIALOG 0, 0, 220, 120
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ntrdps account"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_ACC_TEXT, 8, 6, 204, 34
    LTEXT           "&User name:", -1, 8, 47, 62, 8
    EDITTEXT        IDC_LUSER, 72, 45, 140, 12, ES_AUTOHSCROLL
    LTEXT           "&Password:", -1, 8, 63, 62, 8
    EDITTEXT        IDC_LPW, 72, 61, 140, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Password &again:", -1, 8, 79, 62, 8
    EDITTEXT        IDC_LPW2, 72, 77, 140, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 52, 100, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 118, 100, 50, 14
END
#endif
